<?xml version="1.0" encoding="utf-8"?>
<!-- Code coverage settings for Microsoft.Testing.Extensions.CodeCoverage (passed with the coverage-settings option). -->
<Configuration>
  <CodeCoverage>
    <ModulePaths>
      <Include>
        <ModulePath>.*NpApi\.Api\.dll$</ModulePath>
        <ModulePath>.*NpApi\.ServiceDefaults\.dll$</ModulePath>
      </Include>
    </ModulePaths>
    <Sources>
      <Exclude>
        <!-- Generated by dotnet ef migrations add. -->
        <Source>.*[\\/]Migrations[\\/].*</Source>
        <!-- Source-generator output (OpenAPI, compiler helpers) lives under obj. -->
        <Source>.*[\\/]obj[\\/].*</Source>
      </Exclude>
    </Sources>
    <Attributes>
      <Exclude>
        <Attribute>^System\.CodeDom\.Compiler\.GeneratedCodeAttribute$</Attribute>
        <Attribute>^System\.Diagnostics\.CodeAnalysis\.ExcludeFromCodeCoverageAttribute$</Attribute>
      </Exclude>
    </Attributes>
  </CodeCoverage>
</Configuration>
